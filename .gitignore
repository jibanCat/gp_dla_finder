# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments. Globbed, not listed: naming one venv at a time means the next
# one (.venv-docs-test, venv-openblas, ...) shows up as untracked noise.
.venv*/
venv*/
env/
ENV/
.env
.env.*
.python-version
.direnv/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
coverage.json
htmlcov/
.tox/
.nox/

# Docs build
docs/_build/
docs/source/_build/
site/

# Agent working area — instructions, plans, investigation notes, probes.
# Kept on disk, never committed. Only public-facing docs belong in this repo.
.claude/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Notebooks
.ipynb_checkpoints/

# Large / generated scientific assets (never commit raw data)
*.fits
*.fits.gz
*.h5
*.hdf5
*.mat
*.npz
*.npy
!src/gp_dla_finder/data/**/*.npz
!tests/data/**/*.npz

# Local caches
.cache/
*.log

# Build products of the optional libcerf Voigt extension. The .pyx is the
# source; the .c is regenerated by Cython on every build (it is a build
# requirement), and the shared library is platform-specific.
src/gp_dla_finder/_voigt_ext.c
src/gp_dla_finder/_build_info.py
src/gp_dla_finder/*.so
src/gp_dla_finder/*.dylib
src/gp_dla_finder/*.pyd
# setup.py copies the canonical NOTICE.md into the package at build time.
src/gp_dla_finder/NOTICE.md

# Grids built by tools/build_sample_grid.py or by docs/examples/custom_grid.py.
# The example writes into its own working directory; a reader following the
# tutorial from the repository root would otherwise leave one here.
/grids/
